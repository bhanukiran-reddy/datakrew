# Copy to `.env.development` / `.env.local` (local) or `.env.production` (deploy).
# Fill in values per environment. Do not commit secrets.

# When true: fallback legacy flag for all pages mocked.
USE_MOCK_PAGE_DATA=

NEXT_PUBLIC_GRAPHQL_ENDPOINT=
NEXT_PUBLIC_SITE_NAME=
NEXT_PUBLIC_DEFAULT_DESCRIPTION=
NEXT_PUBLIC_SITE_URL=
DEFAULT_LOCALE=
SUPPORTED_LOCALES=
TITLE_SEPARATOR=
NEXT_PUBLIC_CALENDLY_URL=
NEXT_PUBLIC_ALLOW_ROBOTS=

# Optional: limit mock to specific section types (comma-separated).
# MOCK_SECTION_TYPES=

REVALIDATE_SECRET=

# Optional (used in code; not always set on servers)
# NEXT_PUBLIC_GTM_ID=
# DRAFT_SECRET=
# MOCK_PAGES=
